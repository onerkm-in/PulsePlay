{
 "datasets": [
  {
   "name": "39a5402c",
   "displayName": "Support Data",
   "queryLines": [
    "WITH TopTopics AS (\n    SELECT topic \n    FROM `main`.`dbdemos_aibi_customer_support`.tickets_clean \n    GROUP BY topic ORDER BY COUNT(ticket_id) DESC --LIMIT 1"
   ]
  },
  {
   "name": "56d2ee72",
   "displayName": "Counts by Case Status",
   "queryLines": [
    "SELECT SUM(CASE WHEN t.status = 'In progress' THEN 1 ELSE 0 END) AS in_progress_tickets\n, SUM(CASE WHEN t.status = 'Closed' THEN 1 ELSE 0 END) AS closed_tickets"
   ]
  },
  {
   "name": "24061a29",
   "displayName": "Support Data (Forecasted)",
   "queryLines": [
    "WITH original_table AS (\n    SELECT \n  DATE_TRUNC(\"MONTH\", `close_time`) AS close_time,\n  COUNT(`ticket_id`) AS ticket_id\nFROM (\n    WITH TopTopics AS (\n    SEL"
   ]
  }
 ],
