table performance
	lineageTag: 5c8ad23c-3c83-48b4-9948-6075738c69a5

	measure 'Net Sales USD' = SUM(performance[net_sales_usd])
		formatString: #,0
		lineageTag: cdab01ee-2856-44d3-aa7a-64b61aadd747

	measure 'COGS USD' = SUM(performance[cogs_usd])
		formatString: #,0
		lineageTag: a45e74e4-4590-484d-bbdd-a4e1a43dbf0b

	measure 'Gross Margin Pct' = DIVIDE(100 * (SUM(performance[net_sales_usd]) - SUM(performance[cogs_usd])), SUM(performance[net_sales_usd]))
		formatString: 0.00
		lineageTag: 9d464b8d-5129-4168-beec-adea4c6fb794

	measure 'Forecast Accuracy Pct' = 100 * (1 - DIVIDE(SUMX(performance, ABS(performance[actual_qty] - performance[forecast_qty])), SUM(performance[actual_qty])))
		formatString: 0.00
		lineageTag: 1f99e11a-13b8-4844-94e6-5c5392bbd9f1

	measure 'Forecast Bias Pct' = DIVIDE(100 * (SUM(performance[actual_qty]) - SUM(performance[forecast_qty])), SUM(performance[actual_qty]))
		formatString: 0.00
		lineageTag: 4a0cb970-7812-474f-a257-34d077e53260

	column date_month
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 6ac3a797-e701-401f-bdbd-ca4d6e795963
		summarizeBy: none
		sourceColumn: date_month

		annotation UnderlyingDateTimeDataType = Date

