table ofr
	lineageTag: e6f2041a-520c-4b6d-a9dd-659aa8ef75eb

	measure 'Ordered Qty' = SUM(ofr[ordered_qty])
		formatString: #,0
		lineageTag: e29b7c12-97ec-4528-a87a-04326cdf9c0f

	measure 'Delivered Qty' = SUM(ofr[delivered_qty])
		formatString: #,0
		lineageTag: 4c12f9d7-0aae-4b03-a546-42ff56835614

	measure 'Order Lines' = SUM(ofr[order_lines])
		formatString: #,0
		lineageTag: 8d3388a5-9878-4243-8c3f-3dcaaef3a872

	measure 'Order Fill Rate Pct' = DIVIDE(100 * SUM(ofr[delivered_qty]), SUM(ofr[ordered_qty]))
		formatString: 0.00
		lineageTag: ff15a0cc-05a8-43cb-9d30-8e4247f331f9

	measure 'OTIF Pct' = DIVIDE(100 * SUM(ofr[otif_lines]), SUM(ofr[order_lines]))
		formatString: 0.00
		lineageTag: 1df3bbb2-de1f-4ae0-92de-9051ea827102

