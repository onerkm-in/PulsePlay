{
  "version": "1.0",
  "business_domain": "Supply Chain",
  "notes": "MVP rule pack. action_level must be <= 3 (enforced at load). Detection targets align to PulsePlay certified KPI register.",
  "rules": [
    {
      "rule_id": "SCM-OTIF-001",
      "detector": "kpi_cell",
      "kpi": "OTIF",
      "kpi_unit": "%",
      "business_process": "Customer Service / Fulfilment",
      "detect_metric": "otif_pct",
      "direction": "below",
      "target": 94.0,
      "severity_thresholds": {"critical": 85.0, "high": 90.0, "medium": 92.0},
      "root_cause_category": "supply",
      "persona": "Supply Chain Planner",
      "owner": "Supply Chain Manager",
      "action_code": "trigger_supplier_review",
      "action_level": 3,
      "approval_required": true,
      "description": "OTIF below target and deteriorating; likely supplier late-delivery driven."
    },
    {
      "rule_id": "SCM-FILL-001",
      "detector": "kpi_cell",
      "kpi": "Line Fill Rate",
      "kpi_unit": "%",
      "business_process": "Inventory / Replenishment",
      "detect_metric": "line_fill_rate_pct",
      "direction": "below",
      "target": 95.0,
      "severity_thresholds": {"critical": 85.0, "high": 90.0, "medium": 93.0},
      "root_cause_category": "inventory",
      "persona": "Supply Chain Planner",
      "owner": "Supply Chain Manager",
      "action_code": "trigger_replenishment",
      "action_level": 3,
      "approval_required": true,
      "description": "Line fill below target, driven by on-hand falling below safety stock (stockouts)."
    },
    {
      "rule_id": "SCM-FA-001",
      "detector": "kpi_cell",
      "kpi": "Forecast Accuracy",
      "kpi_unit": "%",
      "business_process": "Demand Planning",
      "detect_metric": "forecast_accuracy_pct",
      "direction": "below",
      "target": 85.0,
      "severity_thresholds": {"critical": 70.0, "high": 78.0, "medium": 82.0},
      "root_cause_category": "demand",
      "persona": "Supply Chain Planner",
      "owner": "Supply Chain Manager",
      "action_code": "trigger_forecast_review",
      "action_level": 3,
      "approval_required": true,
      "description": "Forecast accuracy (1-WMAPE) below target with persistent bias."
    },
    {
      "rule_id": "SCM-SUPP-001",
      "detector": "supplier",
      "kpi": "Supplier On-Time",
      "kpi_unit": "%",
      "business_process": "Supplier Management",
      "detect_metric": "on_time_pct",
      "direction": "below",
      "target": 90.0,
      "severity_thresholds": {"critical": 75.0, "high": 82.0, "medium": 88.0},
      "root_cause_category": "supply",
      "persona": "Supply Chain Manager",
      "owner": "Supply Chain Manager",
      "action_code": "trigger_supplier_perf",
      "action_level": 3,
      "approval_required": true,
      "description": "A supplier's on-time delivery has collapsed below tolerance."
    },
    {
      "rule_id": "SCM-INV-001",
      "detector": "inventory_category",
      "kpi": "Days of Supply",
      "kpi_unit": "days",
      "business_process": "Inventory / Working Capital",
      "detect_metric": "days_of_supply",
      "direction": "above",
      "target": 60.0,
      "severity_thresholds": {"critical": 110.0, "high": 90.0, "medium": 75.0},
      "root_cause_category": "inventory",
      "persona": "Supply Chain Manager",
      "owner": "Supply Chain Manager",
      "action_code": "trigger_inventory_review",
      "action_level": 3,
      "approval_required": true,
      "description": "Excess inventory: days of supply well above target band (working-capital risk)."
    }
  ]
}
